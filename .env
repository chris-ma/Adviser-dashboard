DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_DATA_AS_AT_DATE="2024-03-31"
NEXT_PUBLIC_ASIC_REGISTER_SOURCE="ASIC Financial Adviser Register"

# ── Data Sync ─────────────────────────────────────────────────────────────────
# Bearer token that must be sent with POST /api/sync requests.
# Generate with: openssl rand -hex 32
SYNC_SECRET="change-me-in-production"

# Override the ASIC CSV download URL (optional — defaults to data.gov.au)
# ASIC_CSV_URL="https://data.gov.au/data/dataset/asic-financial-adviser/resource/.../download/..."

# For local testing: point to a downloaded CSV file instead of fetching from the internet
# ASIC_CSV_LOCAL_PATH="/path/to/asic-advisers.csv"
